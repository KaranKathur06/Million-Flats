# Google Cloud Storage
GCP_PROJECT_ID=project-edc515f9-5e87-4784-9cf
GCP_STORAGE_BUCKET=millionflats-media

# Choose one production credential method:
# 1. Mounted key file
# GCP_SERVICE_ACCOUNT_KEY_PATH=/secure/millionflats-gcp-key.json
# 2. Standard ADC file
# GOOGLE_APPLICATION_CREDENTIALS=/secure/millionflats-gcp-key.json
# 3. Securely injected inline JSON; never use NEXT_PUBLIC_ for this value
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Public asset delivery
CDN_BASE_URL=https://cdn.millionflats.com
NEXT_PUBLIC_CDN_DOMAIN=cdn.millionflats.com

# Temporary legacy AWS compatibility; remove only after production acceptance
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEXT_PUBLIC_S3_PUBLIC_BASE_URL=
